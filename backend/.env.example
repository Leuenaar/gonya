# Copy to backend/.env and fill in. Never commit the real file.

# ---- Server ----
PORT=3000
# Deployed frontend origin, added to the CORS allow-list (localhost:5173 is always allowed)
FRONTEND_URL=
# Set to true only while debugging client-side issues; enables the unauthenticated /api/debug-log route
ENABLE_CLIENT_DEBUG=false

# ---- Database and auth (required) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cache and rate limits (required) ----
REDIS_URL=

# ---- LLM providers (required) ----
ANTHROPIC_API_KEY=
# One or more Groq keys. Numbered keys rotate automatically on rate limits.
GROQ_API_KEY_1=
# GROQ_API_KEY_2=
VOYAGE_API_KEY=
# Optional model overrides
# AKSEL_MODEL=
# VERA_MODEL=
# THEONES_MODEL=

# ---- Voice (required at boot) ----
DEEPGRAM_API_KEY_1=
# Google Cloud TTS service account, as a single-line JSON string
GOOGLE_TTS_CREDENTIALS_JSON=
# Optional voice overrides
# AKSEL_VOICE_MODEL=
# VERA_VOICE_MODEL=
# GOOGLE_VOICE_AKSEL_ID=
# GOOGLE_VOICE_VERA_ID=

# ---- Search (required at boot) ----
TAVILY_API_KEY_1=

# ---- Email (required at boot) ----
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=
SUPPORT_NOTIFY_EMAIL=
OWNER_EMAIL=

# ---- Optional features ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GUARDIAN_API_KEY=
BACKEND_URL=
